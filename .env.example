# Copy to .env and adjust. Every setting can also be set as an environment variable.
PAGELESS_DATABASE_URL=postgresql+psycopg://pageless:pageless@localhost:5432/pageless
PAGELESS_VERSIONS_PER_ROUTE=5
PAGELESS_VERSION_LIFETIME_HOURS=5
PAGELESS_GRID_COLUMNS=12
PAGELESS_RETRIES_PER_STEP=1
PAGELESS_OLLAMA_URL=http://localhost:11434
PAGELESS_OLLAMA_NUM_PARALLEL=1
